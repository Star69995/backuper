{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backuper",
  "version": "0.3.8",
  "identifier": "org.tovtech.backuper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Backuper - גיבוי קבצים",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "visible": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "tovtech",
    "shortDescription": "גיבוי קבצים בין כוננים",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Hebrew", "English"],
        "displayLanguageSelector": false,
        "customLanguageFiles": { "Hebrew": "nsis/Hebrew.nsh" },
        "template": "nsis/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFRUQyQzU3QzAyQTJEMkIKUldRckxTckFWeXp0VHFSaG9ncVZLWmdmaGJIQUc1WXR3SVJQQ1AzODY0Nk5TRjF5cmRpcG1jRU8K",
      "endpoints": ["https://github.com/Star69995/backuper/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
